# Zenlife Physio Environment Configuration Example
# Copy to .env.local for local development

# Base Application URL
NEXT_PUBLIC_SITE_URL=https://zenlifephysio.com

# Optional: Webhook URL for external appointment notifications (Slack, Discord, Zapier, CRM)
APPOINTMENT_WEBHOOK_URL=

# Optional: SMTP / Email Gateway configuration (when integrating direct email notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFICATION_EMAIL=info.zenlifephysio@gmail.com
